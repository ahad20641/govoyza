# Holding page for govoyza.com until production's first deploy.
# The partner. and admin. subdomains share this web root; keep them out of search engines.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
    SetEnvIfNoCase Host "^(partner|admin)\." GV_PRIVATE
    Header always set X-Robots-Tag "noindex, nofollow" env=GV_PRIVATE
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(php|phtml|bak|old|sql|zip|env)$">
    Require all denied
</FilesMatch>
