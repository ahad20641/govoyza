# Copy to the server as app/.env and fill in. NEVER commit the real file.
APP_NAME=Govoyza
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate on the server, then back it up offline
APP_URL=https://govoyza.com
APP_TIMEZONE=Asia/Dhaka

# Every GOVOYZA_* key here must be read in config/ (tests/Unit/EnvTemplateTest.php enforces it).
GOVOYZA_DOMAIN=govoyza.com
GOVOYZA_PARTNER_DOMAIN=partner.govoyza.com
GOVOYZA_ADMIN_DOMAIN=admin.govoyza.com
GOVOYZA_CURRENCY=BDT
# Optional: only these IPs/CIDR ranges may open admin.govoyza.com (comma-separated). Empty = anyone (2FA still required).
GOVOYZA_ADMIN_IPS=

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1              # Hostinger: usually localhost / 127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXX_govoyza_prod
DB_USERNAME=uXXXXXXX_govoyza
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_DOMAIN=                # leave empty: separate cookie per subdomain
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
DOCUMENTS_DISK=documents

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@govoyza.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@govoyza.com
MAIL_FROM_NAME=Govoyza

# Payments (sandbox first)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SENTRY_LARAVEL_DSN=
