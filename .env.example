APP_NAME=GOVOYZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

GOVOYZA_DOMAIN=govoyza.com
GOVOYZA_PARTNER_DOMAIN=partner.govoyza.com
GOVOYZA_ADMIN_DOMAIN=admin.govoyza.com
GOVOYZA_STAGING_DOMAIN=staging.govoyza.com
GOVOYZA_CURRENCY=BDT
GOVOYZA_VAT_RATE=0
GOVOYZA_TIER_SILVER_MARKUP_REDUCTION=0
GOVOYZA_TIER_GOLD_MARKUP_REDUCTION=0
GOVOYZA_TIER_PLATINUM_MARKUP_REDUCTION=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MySQL 8+. (sqlite works for local development.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=govoyza
DB_USERNAME=govoyza
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set true in production (HTTPS only cookies)
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Client/agency documents. "local" = storage/app/private/documents, or "s3" (private bucket)
PRIVATE_DISK_DRIVER=local
AWS_PRIVATE_BUCKET=

# Comma-separated IPs/CIDRs of your load balancer / reverse proxy ("*" behind a managed LB)
TRUSTED_PROXIES=127.0.0.1
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Integrations (configured in later phases — leave blank until then)
# ---------------------------------------------------------------
# Payment gateways (Phase 7)
PAYMENT_DEFAULT_GATEWAY=
# SMS / push / courier providers (Phase 6, 12)
SMS_PROVIDER=
COURIER_PROVIDER=
